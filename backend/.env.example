# API Key de Groq (Reemplazar con tu propia clave)
CHATBOT_API_KEY=tu_api_key_de_groq

# Modelo de Groq
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Configuración de base de datos MySQL 
# Formato: mysql+pymysql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=mysql+pymysql://root:@localhost:3306/medicai

# Seguridad JWT (Debe ser una cadena aleatoria y compleja)
SECRET_KEY=tu_clave_secreta_jwt
ACCESS_TOKEN_EXPIRE_MINUTES=60

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_aplicacion
SMTP_FROM=tu_correo@gmail.com

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token
