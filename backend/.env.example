# API Key de Groq (Obtenla en console.groq.com)
CHATBOT_API_KEY=tu_api_key_de_groq_aqui

# Modelo de Groq (Texto y Visión opcionales)
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Configuración de base de datos MySQL 
# Formato: mysql+pymysql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=mysql+pymysql://root:@localhost:3306/medicai

# Seguridad JWT (Genera una clave aleatoria compleja de 32 bytes)
SECRET_KEY=tu_clave_secreta_jwt_super_segura_aqui
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Configuración de Servidor de Correo SMTP (para verificación OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo_gmail_aqui@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion_aqui
SMTP_FROM=tu_correo_gmail_aqui@gmail.com

# Integración con Bot de Telegram
TELEGRAM_BOT_TOKEN=tu_token_de_bot_de_telegram_aqui
