# API Key de Groq (Reemplazar con tu propia clave)
CHATBOT_API_KEY=tu_api_key_de_groq_aqui

# Modelo de Groq
GROQ_MODEL=llama-3.3-70b-versatile

# Configuración de base de datos MySQL 
# Formato: mysql+pymysql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=mysql+pymysql://usuario:contraseña@localhost:3306/medicai

# Seguridad JWT (Debe ser una cadena aleatoria y compleja)
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60
